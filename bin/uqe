#!/usr/bin/env bash
# =============================================================================
# uqe — Universal Quality Engine CLI Wrapper
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
else
  echo "[uqe][ERROR] Python 3.9+ is required but neither python3 nor python was found in PATH." >&2
  exit 1
fi

export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"
exec "$PYTHON_BIN" -m uqe.cli "$@"
